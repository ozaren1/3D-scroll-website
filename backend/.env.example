PORT=4000
DATABASE_PATH=./data/portfolio.db
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Express "trust proxy": false locally, 1 behind a single nginx
TRUST_PROXY=false
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
# npm run hash-password -- 'your password'  (wrap the value in single quotes)
ADMIN_PASSWORD_HASH=
# Media is stored on this server's disk in UPLOAD_DIR and served at /media/.
# Largest accepted video in MB (images are capped at 10 MB)
MAX_VIDEO_MB=2048
# Refuse uploads that would leave less free disk than this, in MB
MIN_FREE_MB=2048
