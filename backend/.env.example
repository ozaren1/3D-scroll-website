PORT=4000
DATABASE_PATH=./data/portfolio.db
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Express "trust proxy": false locally, 1 behind a single nginx
TRUST_PROXY=false
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@example.com
# npm run hash-password -- 'your password'  (wrap the value in single quotes)
ADMIN_PASSWORD_HASH=
# Media storage: "local" keeps files in UPLOAD_DIR; "s3" uploads straight from the admin
# panel to an S3-compatible bucket (Yandex Object Storage, Selectel, VK Cloud…).
STORAGE_DRIVER=local
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket or its CDN, no trailing slash
S3_PUBLIC_URL=https://storage.yandexcloud.net/your-bucket
S3_FORCE_PATH_STYLE=false
