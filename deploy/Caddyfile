# One origin for everything: the site, /api and /media. SITE_ADDRESS is ":80" until a domain
# points here; with a domain ("example.ru") Caddy gets HTTPS certificates by itself.
# REDIRECT_ADDRESS ("www.example.ru") answers with a permanent redirect to the main address.
{$REDIRECT_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Uploaded media straight from disk: Range requests, no Node in the way.
	handle_path /media/* {
		@hidden path_regexp ^/\.
		respond @hidden 404
		root * /srv/uploads
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	# The site does not use the image optimizer: keep the endpoint unreachable.
	respond /_next/image* 404

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		# Browsers honour it only over HTTPS, so it is harmless while the site runs on a bare IP.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
